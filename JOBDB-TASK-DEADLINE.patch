+package workflow
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestTaskContextDeadlineReportsBoundWithoutChangingCancellation(t *testing.T) {
+	deadline := time.Now().Add(time.Minute)
+	ctx, cancel := context.WithCancelCause(context.Background())
+	task := TaskContext{executionContext: ctx, executionDeadline: deadline}
+	got, ok := task.Deadline()
+	if !ok || !got.Equal(deadline) {
+		t.Fatalf("deadline = %v, %v", got, ok)
+	}
+	cause := errors.New("engine timeout cause")
+	cancel(cause)
+	if !errors.Is(context.Cause(task.Context()), cause) {
+		t.Fatal("deadline accessor changed cancellation cause")
+	}
+	outer, stop := context.WithDeadline(context.Background(), deadline.Add(-time.Second))
+	defer stop()
+	task.executionContext = outer
+	got, ok = task.Deadline()
+	if !ok || !got.Equal(deadline.Add(-time.Second)) {
+		t.Fatal("outer deadline was not respected")
+	}
+	if _, ok := (TaskContext{}).Deadline(); ok {
+		t.Fatal("invented deadline")
+	}
+}
