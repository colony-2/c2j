@@ -186,0 +188,11 @@ func (tc TaskContext) Context() context.Context {
+
+// Deadline returns the effective absolute task-attempt deadline, including all
+// enclosing scope and total budgets. It does not change engine cancellation
+// causes or create a new timer. An absent deadline is reported as false.
+func (tc TaskContext) Deadline() (time.Time, bool) {
+	deadline := tc.executionDeadline
+	if outer, ok := tc.Context().Deadline(); ok {
+		deadline = earlier(deadline, outer)
+	}
+	return deadline, !deadline.IsZero()
+}
