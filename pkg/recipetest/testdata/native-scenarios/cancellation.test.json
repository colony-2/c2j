              "effects": {
                "children": [
                  {
                    "bind": "one",
                    "cell": "root",
                    "recipe": "caller-wait.yaml",
                    "inputs": {
                      "marker": "one"
                    }
                  },
                  {
                    "bind": "two",
                    "cell": "root",
                    "recipe": "caller-wait.yaml",
                    "inputs": {
                      "marker": "two"
                    }
                  }
                ]
              }
            }
          },
          {
            "match": {
              "node_path": "driver/next"
            },
            "behavior": {
